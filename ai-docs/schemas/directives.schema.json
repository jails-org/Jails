{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JailsDirectiveReference",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["directive", "category", "description", "syntax", "valueType", "behavior", "examples", "antiPatterns", "relatedDirectives", "runtimeNotes", "performanceNotes"],
    "properties": {
      "directive": { "type": "string" },
      "category": { "type": "string" },
      "description": { "type": "string" },
      "syntax": { "type": "string" },
      "valueType": { "type": "string" },
      "behavior": { "type": "array", "items": { "type": "string" } },
      "examples": { "type": "array", "items": { "type": "string" } },
      "antiPatterns": { "type": "array", "items": { "type": "string" } },
      "relatedDirectives": { "type": "array", "items": { "type": "string" } },
      "runtimeNotes": { "type": "array", "items": { "type": "string" } },
      "performanceNotes": { "type": "array", "items": { "type": "string" } }
    }
  }
}

