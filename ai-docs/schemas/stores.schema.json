{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JailsStorePattern",
  "type": "object",
  "properties": {
    "scope": { "enum": ["component", "page", "global-topic", "external-dependency"] },
    "owner": { "type": "string" },
    "injection": { "enum": ["model", "html-model", "dependencies", "publish-subscribe", "parent-props"] },
    "mutable": { "type": "boolean" },
    "renderTrigger": { "enum": ["state.set", "parent-update", "manual-innerHTML", "none"] },
    "cleanupRequired": { "type": "boolean" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["scope", "injection", "renderTrigger"]
}

