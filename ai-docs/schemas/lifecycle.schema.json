{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JailsLifecycle",
  "type": "object",
  "properties": {
    "registration": { "type": "string" },
    "templateCompilation": { "type": "string" },
    "connected": { "type": "string" },
    "mountEvent": { "const": ":mount" },
    "main": { "type": "string" },
    "update": { "type": "string" },
    "childUpdate": { "type": "string" },
    "unmountEvent": { "const": ":unmount" },
    "cleanup": { "type": "string" }
  },
  "required": ["registration", "templateCompilation", "connected", "mountEvent", "main", "update", "unmountEvent", "cleanup"]
}

